# Firebase Admin SDK — paste the full content of your service-account JSON here
# Find it at: Firebase Console → Project Settings → Service Accounts → Generate key
# The value must be valid JSON (can be multi-line)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"hogarlimpio-dffeb",...}

# CORS — comma-separated list of allowed origins (no trailing slashes)
# For production: https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
